POSTGRES_DB=stockpilot
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=local_development_only_change_me
# Application account is deliberately NOT the PostgreSQL owner.
APP_DB_USER=stockpilot_app
APP_DB_PASSWORD=local_app_password_change_me
DATABASE_URL=postgresql://stockpilot_app:local_app_password_change_me@db:5432/stockpilot
# Only addresses on these private CIDRs may supply the nginx-controlled X-Real-IP.
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8
JWT_SECRET=replace_with_a_random_32_character_secret_before_deploying
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
DEMO_PASSWORD=DemoStock2026!

# v0.7.0: separate opt-in backup container (docker compose --profile backup up -d backup)
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# On Linux set these to `id -u` and `id -g` for the backups/ directory owner.
BACKUP_UID=1000
BACKUP_GID=1000
