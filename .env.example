POSTGRES_DB=stockpilot
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=local_development_only_change_me
# Runtime application principal is separate from the migration/database owner.
APP_DB_USER=stockpilot_app
APP_DB_PASSWORD=local_app_password_change_me
DATABASE_URL=postgresql://stockpilot_app:local_app_password_change_me@db:5432/stockpilot

# Development defaults. Production requires a generated JWT secret, HTTPS CORS
# origins, an empty DEMO_PASSWORD and an individual trusted proxy address.
STOCKPILOT_ENV=development
TRUSTED_PROXY_CIDRS=172.29.250.2/32
JWT_SECRET=replace_with_a_random_secret_before_deploying
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
DEMO_PASSWORD=DemoStock2026!

# Dedicated host path; keep outside the repository and restrict its ACLs.
BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# Linux: set to id -u / id -g of the account owning BACKUP_HOST_DIR.
BACKUP_UID=1000
BACKUP_GID=1000
